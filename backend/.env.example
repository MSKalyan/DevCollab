NODE_ENV=development
PORT=5000

# PostgreSQL (used directly as a connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb

# Standalone Postgres params (Docker compose injects these; not read by db.js)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=postgres

# Test database (falls back to pg-mem when unset)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/appdb_test

# Auth secrets
# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change_this_to_a_long_random_string
JWT_SECRET_REFRESH=change_this_to_another_long_random_string

# Google OAuth (backend verifies tokens with GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend origin used for post-OAuth redirects (no trailing slash)
FRONTEND_URL=http://localhost:3000

# GitHub OAuth (server-side flow; never exposed to the browser)
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Encryption key for GitHub access tokens at rest (AES-256-GCM).
# MUST be a separate, long random key — never reuse JWT_SECRET.
# Generate with: `openssl rand -hex 32`
GITHUB_TOKEN_ENCRYPTION_KEY=change_this_to_a_long_random_string

# Optional read-only PAT for the corpus repo/issue sync. Without it, the
# worker syncs GitHub unauthenticated at 60 requests/hour/IP and will 403
# as soon as the cap is hit. Any classic PAT (even with no scopes) raises
# this to 5000/hour. Never use a user's OAuth access token here.
GITHUB_CORPUS_TOKEN=

# Backfill tuning (rate-limit guardrails)
GITHUB_BACKFILL_MAX_PAGES=10
GITHUB_BACKFILL_MAX_PR_FILES=30
GITHUB_BACKFILL_MAX_REPOS_LANGUAGES=50
# Parallel GitHub requests during a backfill (octokit throttling still queues
# on rate limits, so higher = faster but consumes your API budget sooner).
GITHUB_BACKFILL_PR_CONCURRENCY=8
GITHUB_BACKFILL_LANGUAGE_CONCURRENCY=10

# Amazon S3 (image uploads via multer-s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_bucket_name

# Redis (caching)
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_SECONDS=60
