NODE_ENV=development
PORT=5000

# PostgreSQL (used directly as a connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb

# Standalone Postgres params (Docker compose injects these; not read by db.js)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=postgres

# Test database (falls back to pg-mem when unset)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/appdb_test

# Auth secrets
# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change_this_to_a_long_random_string
JWT_SECRET_REFRESH=change_this_to_another_long_random_string

# Google OAuth (backend verifies tokens with GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend origin used for post-OAuth redirects (no trailing slash)
FRONTEND_URL=http://localhost:3000

# GitHub OAuth (server-side flow; never exposed to the browser)
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Encryption key for GitHub access tokens at rest (AES-256-GCM).
# MUST be a separate, long random key — never reuse JWT_SECRET.
# Generate with: `openssl rand -hex 32`
GITHUB_TOKEN_ENCRYPTION_KEY=change_this_to_a_long_random_string

# Optional read-only PAT for the corpus repo/issue sync. Without it, the
# worker syncs GitHub unauthenticated at 60 requests/hour/IP and will 403
# as soon as the cap is hit. Any classic PAT (even with no scopes) raises
# this to 5000/hour. Never use a user's OAuth access token here.
GITHUB_CORPUS_TOKEN=

# Backfill tuning (rate-limit guardrails)
GITHUB_BACKFILL_MAX_PAGES=10
GITHUB_BACKFILL_MAX_PR_FILES=30
GITHUB_BACKFILL_MAX_REPOS_LANGUAGES=50
# Changed-file paths captured per merged PR. These feed the contribution agent's
# working-style analysis (does this person touch tests? docs? CI?), so lowering
# it to 0 degrades those traits to unknown.
GITHUB_BACKFILL_MAX_PR_FILE_PATHS=50
# Parallel GitHub requests during a backfill (octokit throttling still queues
# on rate limits, so higher = faster but consumes your API budget sooner).
GITHUB_BACKFILL_PR_CONCURRENCY=8
GITHUB_BACKFILL_LANGUAGE_CONCURRENCY=10

# Amazon S3 (image uploads via multer-s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_bucket_name

# Redis (caching)

REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_SECONDS=60

# Transactional email (password reset). Optional in development: when SMTP_HOST
# is unset the reset link is logged to the server console instead of being sent.
# Production MUST set these, otherwise no reset email can be delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DevCollab <no-reply@devcollab.local>"

# Rate limit for unauthenticated /api/auth/{login,register,forgot-password,reset-password}
# attempts per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=20


# Contribution agent LLM (OpenAI-compatible chat completions over fetch).
# OPTIONAL: with LLM_API_KEY unset the agent runs fully deterministically —
# all scores are deterministic either way; the model only supplies prose and
# per-recommendation reason wording. Point LLM_BASE_URL at any compatible
# endpoint (Groq/OpenRouter/Together/local Ollama) to switch providers.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

# --- Groq alternative ---------------------------------------------------
# Groq is OpenAI-compatible, so only these three values change. Recommended
# model ids (Groq deprecates often; check https://console.groq.com/docs/models):
#   openai/gpt-oss-120b — best quality of the current production models
#   openai/gpt-oss-20b  — cheaper and faster, fine for narrative wording
#   LLM_API_KEY=gsk_...
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b

# Bound on issues scored per contribution-agent request (cost control).
CONTRIBUTION_AGENT_MAX_CORPUS=400